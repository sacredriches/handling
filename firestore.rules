rules_version = '2';
// Firebase konsolu → Firestore Database → Rules sekmesine bu dosyanın içeriği yapıştırılıp "Publish" edilir.
service cloud.firestore {
  match /databases/{database}/documents {
    function isEditor() {
      return request.auth != null
        && exists(/databases/$(database)/documents/editors/$(request.auth.token.email.lower()));
    }
    // Panel: herkes okuyabilir. Sadece giriş yapanlar okusun isterseniz: allow read: if request.auth != null;
    match /airports/{icao} {
      allow read: if true;
      allow write: if isEditor();
    }
    match /settings/{id} {
      allow read: if true;
      allow write: if isEditor();
    }
    // Düzenleyici listesi: herkes sadece kendi kaydını görebilir; liste konsoldan yönetilir.
    match /editors/{email} {
      allow read: if request.auth != null && request.auth.token.email.lower() == email;
      allow write: if false;
    }
  }
}
